rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /prendas/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /ventas/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /facturas/{document=**} {
      allow read, write: if request.auth != null;
    }

    match /notas/{document=**} {
      allow read, write: if request.auth != null;
    }

    match /borradores/{document=**} {
      allow read, write: if request.auth != null;
    }
   match /heroSlides/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
match /categorias/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /config/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /resenas/{doc} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['prendaId', 'nombre', 'estrellas', 'texto', 'fecha'])
                    && request.resource.data.prendaId is string
                    && request.resource.data.nombre is string && request.resource.data.nombre.size() > 0 && request.resource.data.nombre.size() <= 40
                    && request.resource.data.texto is string && request.resource.data.texto.size() > 0 && request.resource.data.texto.size() <= 500
                    && request.resource.data.estrellas is int
                    && request.resource.data.estrellas >= 1 && request.resource.data.estrellas <= 5;
      allow update, delete: if request.auth != null;
    }

  }
}
